            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Nouvel entretien planifié\",\n  \"message\": \"Ahmed Ben Ali a un entretien prévu le 20/03/2026 à 10h00\",\n  \"type\": \"interview_scheduled\",\n  \"session_id\": \"{{session_id}}\"\n}"
            }
