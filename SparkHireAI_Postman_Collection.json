              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ahmed\",\n  \"last_name\": \"Ben Ali\",\n  \"contact\": {\n    \"email\": \"ahmed.benali@example.com\",\n    \"phone\": \"+216 55 123 456\",\n    \"linkedin\": \"https://linkedin.com/in/ahmedbenali\",\n    \"github\": \"https://github.com/ahmedbenali\"\n  },\n  \"technical_skills\": [\n    { \"name\": \"Python\",   \"level\": \"Advanced\",      \"years_experience\": 4 },\n    { \"name\": \"FastAPI\",  \"level\": \"Intermediate\",  \"years_experience\": 2 },\n    { \"name\": \"MongoDB\",  \"level\": \"Intermediate\",  \"years_experience\": 2 },\n    { \"name\": \"Machine Learning\", \"level\": \"Advanced\", \"years_experience\": 3 }\n  ],\n  \"experiences\": [\n    {\n      \"title\": \"Data Scientist\",\n      \"company\": \"TechCorp Tunis\",\n      \"location\": \"Tunis\",\n      \"start_date\": \"2022-01\",\n      \"end_date\": null,\n      \"currently_working\": true,\n      \"description\": \"Développement de modèles ML pour la prédiction client\",\n      \"technologies\": [\"Python\", \"Scikit-learn\", \"TensorFlow\"]\n    }\n  ],\n  \"education\": [\n    {\n      \"degree\": \"Ingénieur\",\n      \"field\": \"Data Engineering & Systèmes Décisionnels\",\n      \"institution\": \"ENETCOM Sfax\",\n      \"start_date\": \"2020\",\n      \"end_date\": \"2023\",\n      \"currently_studying\": false\n    }\n  ],\n  \"languages\": [\n    { \"name\": \"Arabic\",  \"level\": \"Native\" },\n    { \"name\": \"French\",  \"level\": \"C1\" },\n    { \"name\": \"English\", \"level\": \"B2\" }\n  ],\n  \"soft_skills\": [\n    { \"name\": \"Teamwork\" },\n    { \"name\": \"Communication\" },\n    { \"name\": \"Problem Solving\" }\n  ],\n  \"certifications\": [\n    {\n      \"name\": \"AWS Certified Developer\",\n      \"issuer\": \"Amazon Web Services\",\n      \"issue_date\": \"2023-06\",\n      \"expiry_date\": \"2026-06\",\n      \"credential_id\": \"AWS-DEV-123456\",\n      \"credential_url\": \"https://aws.amazon.com/verify\"\n    }\n  ]\n}"
