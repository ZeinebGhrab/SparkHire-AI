                  "pm.test('Notification marquée comme lue', () => {",
                  "    pm.expect(json.read).to.be.true;",
                  "});",
                  "console.log('✅ Notification marquée comme lue');"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/notifications/{{notification_id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
