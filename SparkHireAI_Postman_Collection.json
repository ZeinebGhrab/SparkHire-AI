                  "});",
                  "console.log('📬 Compteur après lecture :', json.unread_count, '(attendu :', before, ')');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/notifications/unread-count",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Vérifie que le compteur est revenu à la valeur d'avant l'entretien."
          }
