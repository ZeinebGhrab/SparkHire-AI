{
  "info": {
    "name": "Stark Recruitment AI - API Tests",
    "description": "Collection complète pour tester l'API Stark Recruitment\n\nFlux complet:\n1. Login (obtenir token)\n2. Créer/Lister candidats\n3. Créer/Lister postes\n4. Créer session d'entretien\n5. Tester WebSocket\n6. Consulter résultats",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "candidate_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "position_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login - Obtenir Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Sauvegarder le token automatiquement",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.access_token);",
                  "    console.log('✅ Token sauvegardé:', response.access_token.substring(0, 20) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "rh@stark.tn",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "admin123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login avec email et mot de passe\nCrédentials par défaut:\n- Email: rh@stark.tn\n- Password: admin123"
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Candidates",
      "item": [
        {
          "name": "Créer Candidat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('candidate_id', response._id);",
                  "    console.log('✅ Candidat créé:', response._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ahmed\",\n  \"last_name\": \"Ben Ali\",\n  \"contact\": {\n    \"email\": \"ahmed.benali@example.com\",\n    \"phone\": \"+216 12 345 678\",\n    \"linkedin\": \"https://linkedin.com/in/ahmed-benali\"\n  },\n  \"skills\": [\n    \"Python\",\n    \"FastAPI\",\n    \"MongoDB\",\n    \"React\",\n    \"Docker\"\n  ],\n  \"experiences\": [\n    {\n      \"title\": \"Développeur Full Stack\",\n      \"company\": \"Tech Corp\",\n      \"location\": \"Tunis, Tunisie\",\n      \"start_date\": \"2022-01\",\n      \"currently_working\": true,\n      \"description\": \"Développement d'applications web avec Python et React\",\n      \"technologies\": [\"Python\", \"React\", \"PostgreSQL\"]\n    }\n  ],\n  \"education\": [\n    {\n      \"degree\": \"Licence\",\n      \"field\": \"Informatique\",\n      \"institution\": \"ISIMS Sfax\",\n      \"start_date\": \"2019-09\",\n      \"end_date\": \"2022-06\",\n      \"currently_studying\": false\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/candidates/",
              "host": ["{{base_url}}"],
              "path": ["candidates", ""]
            }
          },
          "response": []
        },
        {
          "name": "Lister Tous les Candidats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/candidates/?skip=0&limit=10",
              "host": ["{{base_url}}"],
              "path": ["candidates", ""],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Obtenir Candidat par ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/candidates/{{candidate_id}}",
              "host": ["{{base_url}}"],
              "path": ["candidates", "{{candidate_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Rechercher par Email",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/candidates/search/email?email=ahmed.benali@example.com",
              "host": ["{{base_url}}"],
              "path": ["candidates", "search", "email"],
              "query": [
                {
                  "key": "email",
                  "value": "ahmed.benali@example.com"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Rechercher par Compétences",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/candidates/search/skills?skills=Python&skills=React&min_match=1",
              "host": ["{{base_url}}"],
              "path": ["candidates", "search", "skills"],
              "query": [
                {
                  "key": "skills",
                  "value": "Python"
                },
                {
                  "key": "skills",
                  "value": "React"
                },
                {
                  "key": "min_match",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Job Positions",
      "item": [
        {
          "name": "Lister Postes avec Questions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const positions = pm.response.json();",
                  "    if (positions.length > 0) {",
                  "        pm.collectionVariables.set('position_id', positions[0]._id);",
                  "        console.log('✅ Position ID sauvegardé:', positions[0]._id);",
                  "        console.log('   Titre:', positions[0].title);",
                  "        console.log('   Questions:', positions[0].questions.length);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/interviews/positions",
              "host": ["{{base_url}}"],
              "path": ["interviews", "positions"]
            },
            "description": "Liste tous les postes avec leurs questions prédéfinies"
          },
          "response": []
        },
        {
          "name": "Obtenir Poste par ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/interviews/positions/{{position_id}}",
              "host": ["{{base_url}}"],
              "path": ["interviews", "positions", "{{position_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Créer Poste avec Questions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ingénieur DevOps\",\n  \"department\": \"IT\",\n  \"questions\": [\n    {\n      \"order\": 1,\n      \"question_ar\": \"قدم نفسك باختصار\",\n      \"question_en\": \"Introduce yourself briefly\",\n      \"max_duration_seconds\": 120\n    },\n    {\n      \"order\": 2,\n      \"question_ar\": \"ما هي خبرتك في DevOps؟\",\n      \"question_en\": \"What is your DevOps experience?\",\n      \"max_duration_seconds\": 180\n    },\n    {\n      \"order\": 3,\n      \"question_ar\": \"صف أدوات CI/CD التي استخدمتها\",\n      \"question_en\": \"Describe CI/CD tools you've used\",\n      \"max_duration_seconds\": 150\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/interviews/positions",
              "host": ["{{base_url}}"],
              "path": ["interviews", "positions"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Interview Sessions",
      "item": [
        {
          "name": "Créer Session d'Entretien",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('session_id', response.session_id);",
                  "    console.log('✅ Session créée!');",
                  "    console.log('   Session ID:', response.session_id);",
                  "    console.log('   Status:', response.status);",
                  "    console.log('   Expire à:', response.expires_at);",
                  "    console.log('');",
                  "    console.log('🎯 Pour tester dans le client:');",
                  "    console.log('   1. python -m client.main');",
                  "    console.log('   2. Entrer:', response.session_id);",
                  "    console.log('   3. Cliquer \"DÉMARRER L\\'ENTRETIEN\"');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidate_id\": \"{{candidate_id}}\",\n  \"job_position_id\": \"{{position_id}}\",\n  \"language\": \"ar\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/interviews/sessions",
              "host": ["{{base_url}}"],
              "path": ["interviews", "sessions"]
            },
            "description": "Crée une nouvelle session d'entretien vocal\n\nRetourne:\n- session_id: à utiliser dans le client\n- expires_at: expire après 30 minutes"
          },
          "response": []
        },
        {
          "name": "Lister Toutes les Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/interviews/sessions?skip=0&limit=10",
              "host": ["{{base_url}}"],
              "path": ["interviews", "sessions"],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Obtenir Session par ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/interviews/sessions/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["interviews", "sessions", "{{session_id}}"]
            },
            "description": "Récupère les détails complets d'une session:\n- Informations de session\n- Liste des questions\n- Liste des réponses avec transcriptions\n- Fichiers audio"
          },
          "response": []
        },
        {
          "name": "Sessions par Candidat",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/interviews/sessions/candidate/{{candidate_id}}",
              "host": ["{{base_url}}"],
              "path": ["interviews", "sessions", "candidate", "{{candidate_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Filtrer par Statut",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/interviews/sessions?status=completed",
              "host": ["{{base_url}}"],
              "path": ["interviews", "sessions"],
              "query": [
                {
                  "key": "status",
                  "value": "completed",
                  "description": "pending | in_progress | completed | cancelled"
                }
              ]
            }
          },
          "response": []
        }
      ]
